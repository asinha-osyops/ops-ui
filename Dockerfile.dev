# Development Dockerfile
FROM node:20-slim

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Verify installation succeeded
RUN ls -la node_modules/.bin/next || (echo "next binary not found!" && exit 1)

# Copy source files (these get overwritten by volume mounts at runtime)
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
